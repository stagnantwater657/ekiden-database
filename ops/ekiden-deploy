#!/bin/bash
# Root-owned entry point. Exactly one immutable version, no shell evaluation.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077
[[ $EUID -eq 0 && $# -eq 1 ]] || { echo 'Root and exactly one image version are required.' >&2; exit 1; }
version=$1
pattern='^[0-9a-f]{40}@sha256:[0-9a-f]{64}$'
[[ $version =~ $pattern ]] || { echo 'Invalid immutable image version.' >&2; exit 1; }
readonly repository=ghcr.io/stagnantwater657/ekiden-database
readonly state=/var/lib/ekiden
readonly config=/etc/ekiden/compose.yaml
exec 9>/run/lock/ekiden-deploy.lock
flock -n 9 || { echo 'Another Ekiden deployment is running.' >&2; exit 1; }
# No caller-controlled Docker host, context, config, Compose path or env file.
engine() {
  /usr/bin/timeout 120s /usr/bin/env -i PATH=/usr/bin:/bin HOME=/root \
    /usr/bin/docker --host unix:///var/run/docker.sock --config /etc/ekiden/docker "$@"
}
compose() {
  /usr/bin/timeout 120s /usr/bin/env -i PATH=/usr/bin:/bin HOME=/root EKIDEN_IMAGE="$repository:$1" \
    /usr/bin/docker --host unix:///var/run/docker.sock --config /etc/ekiden/docker \
    compose --project-name ekiden --project-directory /etc/ekiden \
    --env-file /dev/null -f "$config" "${@:2}"
}
healthy() {
  local id result
  id=$(compose "$1" ps -q web) || return 1
  [[ -n $id ]] || return 1
  result=$(engine inspect --format '{{.State.Health.Status}}' "$id") || return 1
  [[ $result == healthy ]] || return 1
  /usr/bin/curl --fail --silent --max-time 5 http://127.0.0.1:3001/api/health |
    /usr/bin/python3 -c 'import json,sys; d=json.load(sys.stdin); sys.exit(0 if d == {"status":"ok","service":"ekiden-database"} else 1)'
}
previous=''
if [[ -f $state/current ]]; then
  previous=$(cat "$state/current")
  [[ $previous =~ $pattern ]] || { echo 'Invalid stored version; administrator intervention required.' >&2; exit 1; }
  healthy "$previous" || { echo 'Existing deployment is not healthy; administrator intervention required.' >&2; exit 1; }
fi
# Pull failure leaves the running container untouched. Never print registry errors.
if ! engine pull "$repository:$version" > /dev/null 2>&1; then
  echo 'Image pull failed. Administrator must check GHCR access and image availability.' >&2
  exit 1
fi
changed=0
rollback() {
  local status=$?
  trap - EXIT HUP INT TERM
  if (( changed )); then
    if [[ -n $previous ]]; then
      if compose "$previous" up -d --no-deps --wait --wait-timeout 90 web > /dev/null 2>&1 && healthy "$previous"; then
        printf '%s\n' "$previous" > "$state/current.tmp"
        mv -f "$state/current.tmp" "$state/current"
        echo 'Deployment failed; previous healthy image restored.' >&2
      else
        echo 'Deployment and rollback failed; administrator intervention required.' >&2
      fi
    else
      compose "$version" stop web > /dev/null 2>&1 || true
      echo 'First deployment failed; only the Ekiden web service was stopped.' >&2
    fi
  fi
  exit "$status"
}
trap rollback EXIT
trap 'exit 1' HUP INT TERM
changed=1
if ! compose "$version" up -d --no-deps --wait --wait-timeout 90 web > /dev/null 2>&1 || ! healthy "$version"; then
  echo 'Ekiden deployment did not pass health checks.' >&2
  exit 1
fi
if [[ -n $previous && $previous != "$version" ]]; then
  printf '%s\n' "$previous" > "$state/previous.tmp"
  mv -f "$state/previous.tmp" "$state/previous"
fi
printf '%s\n' "$version" > "$state/current.tmp"
mv -f "$state/current.tmp" "$state/current"
changed=0
trap - EXIT HUP INT TERM
echo 'Ekiden deployment passed health checks.'
