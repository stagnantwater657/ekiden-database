#!/usr/bin/python3 -I
"""Root-only, fixed cgroup v2 budget for Ekiden BuildKit workers. No arguments."""
import fcntl
import os
from pathlib import Path
import sys

ROOT = Path('/sys/fs/cgroup')
NAME = 'ekiden-build'
VALUES = {'memory.max': '1342177280', 'memory.swap.max': '0',
          'cpu.max': '100000 100000', 'pids.max': '256'}


def configure(root=ROOT):
    if (not (root / 'cgroup.controllers').is_file() or
            not {'cpu', 'memory', 'pids'} <= set((root / 'cgroup.subtree_control').read_text().split())):
        raise RuntimeError('Required cgroup v2 controllers are not enabled by the host')
    group = root / NAME
    group.mkdir(exist_ok=True)
    current = {key: (group/key).read_text().strip() if (group/key).exists() else None for key in VALUES}
    if current != VALUES:
        # Never resize an active existing budget. Initial setup is empty.
        active = (group/'cgroup.events').read_text() if (group/'cgroup.events').exists() else 'populated 0'
        if 'populated 1' in active:
            raise RuntimeError('Active worker budget differs; stop the dedicated builder before maintenance')
        for key, value in VALUES.items():
            (group/key).write_text(value+'\n')
    # This affects only the new fixed subtree, never global Docker settings.
    (group/'cgroup.subtree_control').write_text('+cpu +memory +pids\n')
    if any((group/key).read_text().strip() != value for key,value in VALUES.items()):
        raise RuntimeError('Worker budget did not take effect')


if __name__ == '__main__':
    try:
        if os.geteuid() != 0 or len(sys.argv) != 1:
            raise RuntimeError('Root and no arguments required')
        with open('/run/lock/ekiden-deploy.lock', 'a') as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            configure()
        print('Ekiden worker cgroup limits verified.')
    except Exception:
        print('Ekiden worker cgroup setup failed; no global controller changes attempted.', file=sys.stderr)
        sys.exit(1)
