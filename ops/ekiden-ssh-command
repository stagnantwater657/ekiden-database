#!/bin/bash
# Installed root-owned. SSH arguments are data, never eval'ed.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
if [[ ${SSH_ORIGINAL_COMMAND:-} =~ ^deploy\ ([0-9a-f]{40}@sha256:[0-9a-f]{64})$ ]]; then
  exec /usr/bin/sudo -n -- /usr/local/sbin/ekiden-deploy "${BASH_REMATCH[1]}"
fi
echo 'Only deploy <40-character SHA>@sha256:<64-character digest> is permitted.' >&2
exit 1
