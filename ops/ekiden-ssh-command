#!/bin/bash
# Root-owned ForceCommand: exact grammar only, never eval SSH_ORIGINAL_COMMAND.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
command=${SSH_ORIGINAL_COMMAND:-}
if [[ $command =~ ^upload\ ([0-9a-f]{40})\ ([0-9a-f]{64})\ (sha256:[0-9a-f]{64})\ ([1-9][0-9]{0,9})$ ]]; then
  # The root program independently revalidates every field and the size limit.
  exec /usr/bin/sudo -n -- /usr/local/sbin/ekiden-deploy upload \
    "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
elif [[ $command =~ ^deploy\ ([0-9a-f]{40})\ (sha256:[0-9a-f]{64})$ ]]; then
  exec /usr/bin/sudo -n -- /usr/local/sbin/ekiden-deploy deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
fi
echo 'Only the validated Ekiden upload/deploy protocol is permitted.' >&2
exit 1
