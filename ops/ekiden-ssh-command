#!/bin/bash
# Source-only delegation closes the legacy image activation CI bypass.
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
command=${SSH_ORIGINAL_COMMAND:-}
if [[ $command =~ ^(deploy-source|build-source)\ ([0-9a-f]{40})$ ]]; then
  exec /usr/bin/sudo -n -- /usr/local/sbin/ekiden-deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
fi
echo 'Only build-source/deploy-source with one full lowercase commit SHA is permitted.' >&2
exit 1
